# Copy to .env and fill in. .env is gitignored.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
JOHN_VOICE_ID=
REFERRAL_URL=https://example.com/join/john

# ElevenLabs TTS model. Flash in dev (0.5 credit/char); switch for the demo.
TTS_MODEL=eleven_flash_v2_5
# 1 = never call ElevenLabs TTS; render a local tone instead (dev/tests)
TTS_MOCK=0
STT_MODEL=scribe_v2

BRAIN_MODEL=claude-opus-5-5

# WhatsApp session (whatsmeow). Separate from the app DB so re-seeding never unlinks.
WA_SESSION=data/wa-session.db
# Optional comma-separated phone numbers (digits only) the bot will answer. Empty = everyone.
ALLOWLIST=
